{
  "name": "huxerui-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-site.mjs && astro dev",
    "check": "node scripts/prepare-site.mjs && astro check",
    "build": "node scripts/prepare-site.mjs && astro check && astro build",
    "preview": "astro preview",
    "sync:content": "node scripts/sync-huxerui-content.mjs",
    "collect:releases": "node scripts/collect-release-data.mjs",
    "stage:examples": "node scripts/stage-web-examples.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "typescript": "5.9.2"
  }
}
