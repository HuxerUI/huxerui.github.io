---
import { existsSync } from "node:fs";
import path from "node:path";

interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
const entry = `/demos/${slug}/index.html`;
const available = existsSync(path.join(process.cwd(), "public", "demos", slug, "index.html"));
---

<div class="demo-frame">
  {available && <div class="demo-toolbar"><a href={entry}>Open full screen</a></div>}
  {available ? (
    <iframe src={entry} title={`${title} interactive HuxerUI Web example`} loading="lazy"></iframe>
  ) : (
    <div class="demo-placeholder">
      <p>The WebAssembly build is unavailable in this preview.</p>
    </div>
  )}
</div>
