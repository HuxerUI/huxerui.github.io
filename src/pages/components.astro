---
import BaseLayout from "../layouts/BaseLayout.astro";
import { componentGroups } from "../data/components";
---

<BaseLayout title="Components" description="Explore HuxerUI controls, layouts, input, navigation, presentation, and graphics APIs.">
  <div class="page-shell">
    <header class="page-hero">
      <div>
        <h1>Components</h1>
      </div>
      <p>
        Browse the controls, layouts, and presentation APIs included in HuxerUI.
      </p>
    </header>
    <section class="section" aria-label="Component groups">
      <div class="card-grid">
        {componentGroups.map((group) => (
          <article class="content-card">
            <h2>{group.name}</h2>
            <p>{group.description}</p>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            <a class="card-link" href={group.href}>View component documentation</a>
          </article>
        ))}
      </div>
    </section>
    <aside class="callout">
      <h2>Custom components</h2>
      <p>
        Use ordinary C++ functions to compose controls. When you need a custom layout, drawing, or retained behavior, use the framework's extension APIs.
      </p>
      <a class="card-link" href="/docs/guides/extensions/">Read the extension guide</a>
    </aside>
  </div>
</BaseLayout>
