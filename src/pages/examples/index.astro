---
import DemoFrame from "../../components/DemoFrame.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import sourceConfig from "../../../huxerui-source.json";

const source = `${site.repository}/tree/${sourceConfig.ref}/examples`;
---

<BaseLayout title="UI Gallery" description="Try HuxerUI controls, layouts, themes, and motion in the browser.">
  <div class="page-shell">
    <header class="page-hero">
      <h1>UI Gallery</h1>
      <div>
        <p>Try the controls, resize the layout, and switch between Material and Flat. The gallery runs HuxerUI compiled to WebAssembly.</p>
        <div class="button-row">
          <a class="card-link" href={`${site.repository}/blob/${sourceConfig.ref}/examples/ui_gallery/main.cpp`}>View C++ source</a>
          <a class="card-link" href="/docs/components/">Component reference</a>
        </div>
      </div>
    </header>
    <DemoFrame slug="ui_gallery" title="UI Gallery" />
    <div class="button-row gallery-source">
      <a class="card-link" href={source}>Browse example source</a>
    </div>
  </div>
</BaseLayout>
