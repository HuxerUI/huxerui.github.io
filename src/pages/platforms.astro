---
import BaseLayout from "../layouts/BaseLayout.astro";
import { platforms } from "../data/platforms";
---

<BaseLayout title="Platforms" description="HuxerUI platform support across Windows, macOS, Linux, Web, Android, and iOS.">
  <div class="page-shell">
    <header class="page-hero">
      <div>
        <h1>Platforms</h1>
      </div>
      <p>
        The shared runtime handles composition and layout. Each backend connects it to the platform's windowing, input, text services, and renderer.
      </p>
    </header>
    <section class="section" aria-label="Platform support">
      <div class="platform-grid">
        {platforms.map((platform) => (
          <article class="platform-card">
            <h2>{platform.status === "Supported" ? <a href={`/docs/platforms/${platform.name.toLowerCase()}/`}>{platform.name}</a> : platform.name}</h2>
            {platform.stack && <p class="platform-stack">{platform.stack}</p>}
            <p>{platform.detail}</p>
          </article>
        ))}
      </div>
    </section>
    <aside class="callout">
      <h2>Platform capabilities</h2>
      <p>
        Compare supported features, platform restrictions, and setup requirements.
      </p>
      <a class="card-link" href="/docs/platforms/">Read platform guides</a>
    </aside>
  </div>
</BaseLayout>
