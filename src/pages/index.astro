---
import BaseLayout from "../layouts/BaseLayout.astro";
import galleryDark from "../assets/ui-gallery-dark.webp";
import galleryLight from "../assets/ui-gallery-light.webp";
import { platforms } from "../data/platforms";

const supportedPlatforms = platforms.filter((platform) => platform.status === "Supported");

const counter = `<span class="code-attribute">[[huxerui::composable]]</span>
<span class="code-type">View</span> Counter() {
  <span class="code-keyword">auto</span> count = UseState(<span class="code-number">0</span>);

  <span class="code-keyword">return</span> <span class="code-type">Column</span> {
    Text::Format(<span class="code-string">"Count: {}"</span>, count),
    <span class="code-type">Button</span>(<span class="code-string">"Increment"</span>).OnClick([count] {
      count += <span class="code-number">1</span>;
    }),
  }.With(Padding(<span class="code-number">24.0F</span>), Spacing(<span class="code-number">12.0F</span>));
}`;
---

<BaseLayout>
  <div class="page-shell">
    <section class="hero" aria-labelledby="intro">
      <div class="hero-copy">
        <h1 id="intro">Declarative UI<br />for C++20</h1>
        <p>HuxerUI is an open-source framework for desktop, mobile, and Web. Write views as C++ functions and share application code across platforms.</p>
        <div class="button-row">
          <a class="button button--primary" href="/docs/get-started/installation/">Get started</a>
          <a class="button" href="/examples/">Open UI Gallery</a>
        </div>
      </div>
      <figure class="code-window">
        <figcaption>counter.cpp</figcaption>
        <pre><code set:html={counter}></code></pre>
      </figure>
    </section>

    <nav class="platform-list" aria-label="Supported platforms">
      <span>Supported platforms</span>
      <ul>
        {supportedPlatforms.map((platform) => (
          <li><a href={`/docs/platforms/${platform.name.toLowerCase()}/`}>{platform.name}</a></li>
        ))}
      </ul>
    </nav>

    <section class="section" aria-labelledby="gallery">
      <div class="section-heading">
        <div>
          <h2 id="gallery">UI Gallery</h2>
          <p>Try the controls, layouts, and themes in a C++ application running in your browser.</p>
        </div>
        <a class="card-link" href="/examples/">Run the Web demo</a>
      </div>
      <figure class="gallery-figure">
        <div class="gallery-images">
          <img class="gallery-image gallery-image--light" src={galleryLight.src} alt="HuxerUI UI Gallery with toggles, tabs, and a theme selector" width={galleryLight.width} height={galleryLight.height} loading="lazy" decoding="async" />
          <img class="gallery-image gallery-image--dark" src={galleryDark.src} alt="HuxerUI UI Gallery with toggles, tabs, and a theme selector" width={galleryDark.width} height={galleryDark.height} loading="lazy" decoding="async" />
        </div>
        <figcaption>Material theme in the WebAssembly build</figcaption>
      </figure>
    </section>

    <section class="section framework" aria-labelledby="official-libraries">
      <div>
        <h2 id="official-libraries">Official libraries</h2>
        <p>Add a library to an existing HuxerUI project and use it through its own C++ API.</p>
        <p><a class="card-link" href="/docs/libraries/">Browse official libraries</a></p>
      </div>
      <dl class="framework-list">
        <div>
          <dt><a href="/docs/libraries/#editors-and-documents">Editors and documents</a></dt>
          <dd>Code and rich-text editors, Markdown and PDF rendering, and embedded web content.</dd>
        </div>
        <div>
          <dt><a href="/docs/libraries/#data-and-application-services">Data and services</a></dt>
          <dd>SQLite persistence, virtualized tables, interactive charts, and QR codes.</dd>
        </div>
        <div>
          <dt><a href="/docs/libraries/#media-and-device-integration">Media and devices</a></dt>
          <dd>Audio and video playback, camera and microphone capture, and map integration.</dd>
        </div>
      </dl>
    </section>

    <section class="section framework" aria-labelledby="architecture">
      <div>
        <h2 id="architecture">Framework architecture</h2>
        <p>A shared runtime drives the interface. Each backend connects it to the host's windowing, input, text, and graphics APIs.</p>
      </div>
      <dl class="framework-list">
        <div>
          <dt><a href="/docs/dsl/fundamentals/">Composition</a></dt>
          <dd>Compose views with typed modifiers and events. State changes recompose the scopes that read them.</dd>
        </div>
        <div>
          <dt><a href="/docs/guides/extensions/">Retained runtime</a></dt>
          <dd>The runtime keeps mounted nodes and coordinates layout, input, animation, and drawing.</dd>
        </div>
        <div>
          <dt><a href="/docs/platforms/">Platform integration</a></dt>
          <dd>Use typed APIs to embed platform views, access services, or present frames from a texture producer.</dd>
        </div>
      </dl>
    </section>

    <section class="section framework" aria-labelledby="first-app">
      <div>
        <h2 id="first-app">Build your first app</h2>
        <p>Install the SDK and Web prerequisites, then create and run a starter project.</p>
        <div class="button-row">
          <a class="button button--primary" href="/downloads/">Download SDK</a>
          <a class="button" href="/docs/get-started/create-a-project/">Read the quick start</a>
        </div>
      </div>
      <figure class="code-window">
        <figcaption>Terminal</figcaption>
        <pre><code>huxerui create app hello --platform web
cd hello
huxerui run web</code></pre>
      </figure>
    </section>
  </div>
</BaseLayout>
